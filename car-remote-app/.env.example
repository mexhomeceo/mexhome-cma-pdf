# ── SmartCar (works with Ford, Tesla, GM, Honda, BMW, and 40+ brands) ──────
# Sign up free at https://smartcar.com → Create an App → copy credentials below

SMARTCAR_CLIENT_ID=your_client_id_here
SMARTCAR_CLIENT_SECRET=your_client_secret_here

# Set this to your deployed URL + /callback, e.g.:
# https://your-app.railway.app/callback
# For local dev: http://localhost:3001/callback
SMARTCAR_REDIRECT_URI=http://localhost:3001/callback

# Use 'simulated' to test without a real car connection, 'live' for real vehicle
SMARTCAR_MODE=live

PORT=3001
